<!DOCTYPE html>
{#
  Generic web-server error page. Rendered once per entry in
  renderer.ERROR_PAGES, so 401 and the catch-all page cannot drift apart.

  Two constraints shape this template:

  * Every path is root-absolute. A web server serves an error document at
    whatever URL the visitor asked for (/editions/2026-09-16.html as much
    as /), so the relative asset paths the other templates use would
    resolve against the wrong directory.
  * The page must stay useful when the stylesheet is not loaded — on a 401
    the server may well refuse /assets/style.css too, if it was not
    excluded from the auth requirement.

  Text is English on purpose: this is server chrome, not edition content.
#}
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>Der Frankenbote — {{ title }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:wght@500;600;700&display=swap">
    <link rel="stylesheet" href="/assets/style.css">
    <link rel="icon" type="image/svg+xml" href="/assets/frankenrechen.svg">
</head>
<body>
<main>

    <header class="masthead">
        <a href="/index.html">
            <img class="masthead__icon"
                 src="/assets/frankenrechen.svg"
                 alt=""
                 width="56" height="56">
        </a>
        <div>
            <h1 class="masthead__title">
                Der Frankenbote
                <span class="masthead__subtitle">{{ subtitle }}</span>
            </h1>
        </div>
    </header>

    <section class="error">
        {% if status_code %}
        <p class="error__code">{{ status_code }}</p>
        {% endif %}
        <h2 class="error__title">{{ title }}</h2>

        {% for paragraph in body %}
        <p class="error__message">{{ paragraph }}</p>
        {% endfor %}

        <p class="error__actions">
            <a class="error__action" href="/index.html">{{ action_label }}</a>
        </p>

        <p class="error__hint">{{ hint }}</p>
    </section>

    <footer class="colophon">
        <p>Personal weekly digest from Franconia</p>
    </footer>

</main>
</body>
</html>
